{
  "name": "simuladorb2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Simulador académico de selección de materiales · Planta de gas B2 (UIS)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "validacion": "vitest run src/engine/validacion.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
